{
  "name": "dasomel-blog",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "bun run next dev",
    "build": "bun run next build && bun scripts/generate-rss.js",
    "build:tools": "bun build scripts/generate-rss.js --outfile .bun-dist/generate-rss.js --target=bun",
    "test": "bun test",
    "events:fetch": "bun scripts/fetch-seoul-events.mjs",
    "festivals:fetch": "bun scripts/fetch-festivals.mjs",
    "start": "bun run next start",
    "lint": "bun run eslint .",
    "projects:refresh": "bun scripts/refresh-project-metadata.mjs && bun scripts/refresh-project-audit.mjs && bun scripts/refresh-oss-issues.mjs && bun scripts/refresh-oss-open-issues.mjs && bun scripts/refresh-oss-adoption-discovery.mjs",
    "digest:collect": "bun scripts/collect-feeds.mjs",
    "digest": "bun scripts/generate-daily-digest.mjs",
    "digest:enrich-publish": "bun scripts/publish-enrichment.mjs",
    "digest:check": "bun scripts/check-enrichment.mjs",
    "digest:enrich-apply": "bun scripts/enrich-apply.mjs"
  },
  "dependencies": {
    "next-mdx-remote-client": "^2.1.12",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "feed": "^6.0.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.577.0",
    "mermaid": "^11.16.1",
    "next": "^16.2.1",
    "next-intl": "^4.13.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reading-time": "^1.5.0",
    "rehype-pretty-code": "^0.14.5",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/typography": "^0.5.19",
    "@types/bun": "^1.3.10",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.1",
    "postcss": "^8.5.26",
    "rss-parser": "^3.13.0",
    "typescript": "^5.9.3"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@swc/core",
    "sharp",
    "unrs-resolver"
  ],
  "overrides": {
    "postcss": "^8.5.26",
    "sharp": "^0.35.0",
    "js-yaml@^3.0.0": "^3.15.1",
    "js-yaml@^4.0.0": "^4.3.1",
    "brace-expansion@^1.0.0": "1.1.18",
    "brace-expansion@^2.0.0": "2.1.4",
    "brace-expansion@^3.0.0": "3.0.6",
    "brace-expansion@^5.0.0": "5.0.9",
    "dompurify": "^3.4.13",
    "nanoid": "^3.3.18"
  }
}
